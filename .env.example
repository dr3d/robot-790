# Robot 790 local environment.
# Copy to .env and fill in private values. .env is ignored by git.

# Cloud image generation.
OPENAI_API_KEY=
ROBOT_790_IMAGE_PROVIDER=openai
ROBOT_790_OPENAI_IMAGE_MODEL=gpt-image-1-mini
ROBOT_790_OPENAI_IMAGE_QUALITY=low
ROBOT_790_IMAGE_SIZE=1024x1024
# STS page can override image model/quality per browser session.
# Try ROBOT_790_OPENAI_IMAGE_MODEL=gpt-image-1 for higher-quality final passes.

# Optional OpenAI LLM brain preset for the STS page Brain dropdown.
# Uses OPENAI_API_KEY above unless ROBOT_790_OPENAI_LLM_API_KEY is set.
ROBOT_790_OPENAI_LLM_MODEL=gpt-4.1-mini
# ROBOT_790_OPENAI_LLM_BASE_URL=https://api.openai.com/v1
# ROBOT_790_OPENAI_LLM_API_KEY=

# Optional generated image output override.
# ROBOT_790_IMAGE_OUTPUT_DIR=D:\_PROJECTS\robot-790\logs\generated-images

# Optional robot endpoints used by backend tools.
# ROBOT_790_FACE_URL=http://esp32-eyes.local/
# ROBOT_790_CHASSIS_URL=http://esp32-chassis.local/

# Optional current embodiment text injected into the STS page prompt.
# ROBOT_790_CURRENT_EMBODIMENT=Your current embodiment is a local ESP32-driven face: eye displays, mouth display, voice, and optional tracked chassis tools when connected.
# ROBOT_790_BODY_TRAJECTORY=Your body is an evolving 790-inspired robot platform; treat live runtime state and tool results as the authority on what you can currently do.
# Level 12 idle loop guard breath in seconds. Keep short for content-mining runs.
# ROBOT_790_IDLE_LEVEL12_COOLDOWN_S=12

# Audio recording MP4 conversion trims leading/trailing silence by default.
# Raw source recordings are still preserved untouched in logs/audio.
# ROBOT_790_AUDIO_TRIM_SILENCE=true
# ROBOT_790_AUDIO_TRIM_THRESHOLD=-45dB
# ROBOT_790_AUDIO_TRIM_SILENCE_S=0.8
# ROBOT_790_AUDIO_TRIM_KEEP_S=0.15
# Audio recordings can also burn Robot 790 phrase captions into the MP4.
# Timing comes from live transcript chunks, so this is approximate.
# Off by default until the caption path is tuned; raw source recordings are unaffected.
# ROBOT_790_AUDIO_CAPTIONS=false
# ROBOT_790_CAPTION_WORDS_PER_CARD=3
# ROBOT_790_CAPTION_OFFSET_MS=-150
# ROBOT_790_CAPTION_MIN_CARD_S=0.35
# ROBOT_790_CAPTION_MAX_CARD_S=1.4

# Optional Home Assistant smart-home proxy.
# Create a long-lived access token in Home Assistant, then expose only safe,
# reversible aliases here. Allowed domains are light, switch, and fan.
# ROBOT_790_HOME_ASSISTANT_URL=http://homeassistant.local:8123
# ROBOT_790_HOME_ASSISTANT_TOKEN=
# ROBOT_790_SMART_HOME_DEVICE_LIVING_ROOM_LIGHT=light.living_room
# ROBOT_790_SMART_HOME_DEVICE_EXTRA_LIGHT=light.extra_light
# Alternative compact form:
# ROBOT_790_SMART_HOME_DEVICES=living_room_light=light.living_room;extra_light=light.extra_light

# Optional note/memory roots.
# ROBOT_790_NOTES_PATH=D:\_PROJECTS\robot-790\notes
# ROBOT_790_MEMORY_PATH=D:\_PROJECTS\robot-790\memory.v1.json

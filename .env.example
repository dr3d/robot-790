# Robot 790 local environment.
# Copy to .env and fill in private values. .env is ignored by git.

# Cloud image generation.
OPENAI_API_KEY=
ROBOT_790_IMAGE_PROVIDER=openai
ROBOT_790_OPENAI_IMAGE_MODEL=gpt-image-1-mini
ROBOT_790_OPENAI_IMAGE_QUALITY=low
ROBOT_790_IMAGE_SIZE=1024x1024

# Optional OpenAI LLM brain preset for the STS page Brain dropdown.
# Uses OPENAI_API_KEY above unless ROBOT_790_OPENAI_LLM_API_KEY is set.
ROBOT_790_OPENAI_LLM_MODEL=gpt-4.1-mini
# ROBOT_790_OPENAI_LLM_BASE_URL=https://api.openai.com/v1
# ROBOT_790_OPENAI_LLM_API_KEY=

# Optional generated image output override.
# ROBOT_790_IMAGE_OUTPUT_DIR=D:\_PROJECTS\robot-790\logs\generated-images

# Optional robot endpoints used by backend tools.
# ROBOT_790_FACE_URL=http://esp32-eyes.local/
# ROBOT_790_CHASSIS_URL=http://esp32-chassis.local/

# Optional note/memory roots.
# ROBOT_790_NOTES_PATH=D:\_PROJECTS\robot-790\notes
# ROBOT_790_MEMORY_PATH=D:\_PROJECTS\robot-790\memory.v1.json

QWEN_TTS_HOST=0.0.0.0
QWEN_TTS_PORT=8000
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_LANGUAGE=English
QWEN_TTS_VOICE=Aiden
QWEN_TTS_DEVICE_MAP=cuda:0
